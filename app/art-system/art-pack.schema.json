{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/art-pack.schema.json",
  "title": "Japanese story art pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "labels",
    "cover",
    "scenes",
    "characters",
    "provenance"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "title": { "$ref": "#/$defs/localizedText" },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["volume"],
      "properties": {
        "volume": { "type": "string", "minLength": 1 }
      }
    },
    "cover": { "$ref": "#/$defs/publicPng" },
    "scenes": {
      "type": "object",
      "description": "One entry per background the story can cut to. Stages reference these by key.",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": { "$ref": "#/$defs/scene" }
    },
    "characters": {
      "type": "object",
      "description": "One entry per other party the story can cut to. Stages reference these by key.",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": { "$ref": "#/$defs/character" }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["creator", "generator", "generatedAt", "promptGuide"],
      "properties": {
        "creator": { "type": "string", "minLength": 1 },
        "generator": { "type": "string", "minLength": 1 },
        "generatedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "promptGuide": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" }
      }
    }
  },
  "$defs": {
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["landscape", "portrait", "focus"],
      "properties": {
        "landscape": { "$ref": "#/$defs/publicPng" },
        "portrait": { "$ref": "#/$defs/publicPng" },
        "focus": {
          "type": "object",
          "additionalProperties": false,
          "required": ["landscape", "portrait"],
          "properties": {
            "landscape": { "$ref": "#/$defs/position" },
            "portrait": { "$ref": "#/$defs/position" }
          }
        },
        "scale": {
          "type": "number",
          "minimum": 1,
          "maximum": 2,
          "description": "Camera push-in about the focus point. 1 is the plate as generated."
        },
        "foreground": { "$ref": "#/$defs/publicPng" }
      }
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "anchor", "heightPercent", "bottomPercent", "art"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "anchor": { "enum": ["left", "right"] },
        "heightPercent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mobile", "desktop"],
          "properties": {
            "mobile": { "type": "number", "minimum": 30, "maximum": 90 },
            "desktop": { "type": "number", "minimum": 30, "maximum": 90 }
          }
        },
        "bottomPercent": {
          "type": "number",
          "minimum": -10,
          "maximum": 30
        },
        "art": {
          "type": "object",
          "additionalProperties": false,
          "required": ["neutral", "positive", "concerned"],
          "properties": {
            "neutral": { "$ref": "#/$defs/publicPng" },
            "positive": { "$ref": "#/$defs/publicPng" },
            "concerned": { "$ref": "#/$defs/publicPng" }
          }
        }
      }
    },
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ja", "en"],
      "properties": {
        "ja": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    },
    "publicPng": {
      "type": "string",
      "pattern": "^/art-packs/[a-z][a-z0-9-]*/[a-z0-9-]+\\.png$"
    },
    "position": {
      "type": "string",
      "pattern": "^(?:100|\\d{1,2})% (?:100|\\d{1,2})%$"
    }
  }
}
